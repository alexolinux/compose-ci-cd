# Default values for all build and runtime variables
# This file serves as the single source of truth for default values
# Copy this to .env and customize for your environment

# =============================================================================
# SYSTEM CONFIGURATION
# =============================================================================
CONFIG="${HOME}/.config/microservices"
WORKSPACE="${HOME}/workspace"
ARCH="amd64"
TZ="UTC"
HOST_UID="1000"
HOST_GID="1000"
USER_NAME="coder"

# =============================================================================
# CI/CD TOOLS VERSIONS (Shared across all services)
# =============================================================================
TF_VERSION="1.7.5"
KUBECTL_VERSION="v1.29.2"
HELM_VERSION="v3.14.2"
AWS_CLI_VERSION="2.15.25"

# =============================================================================
# CODE SERVER
# =============================================================================
CODE_VERSION="4.112.0-39"
CODE_PORT="8081"
CODE_PASSWORD="changeme"

# =============================================================================
# JENKINS
# =============================================================================
JENKINS_VERSION="latest-jdk21"
JENKINS_PORT="8008"
JENKINS_AGENT_PORT="50000"

# =============================================================================
# N8N
# =============================================================================
N8N_VERSION="2.13.2"
N8N_PORT="5678"
N8N_HOST="n8n.localhost"
N8N_USER="admin"
N8N_PASSWORD="changeme"

# =============================================================================
# GIT COMPOSE SERVICES (Optional)
# =============================================================================
# GITEA_VERSION="latest"
# GITEA_PORT="3000"
# GITEA_SSH_PORT="2222"
# GITLAB_HOME="${HOME}/gitlab"